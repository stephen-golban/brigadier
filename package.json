{
  "name": "@stephen-golban/brigadier",
  "version": "0.0.0",
  "description": "Orchestrate AI coding work from the command line",
  "license": "MIT",
  "type": "module",
  "bin": {
    "brigadier": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "bun build ./src/cli.ts --compile --bytecode --minify --sourcemap --outfile ./brigadier",
    "check": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
