{
  "name": "@stephen-golban/brigadier",
  "version": "0.1.1",
  "description": "Orchestrate AI coding work from the command line",
  "license": "MIT",
  "type": "module",
  "bin": {
    "brigadier": "./bin/brigadier.js",
    "brigadier-mcp": "./bin/brigadier-mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "default": "./dist/contracts.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:dist && bun run build:mcp && bun run build:binary && bun run build:codesign",
    "build:binary": "bun build ./src/cli.ts --compile --bytecode --minify --sourcemap --outfile ./brigadier",
    "build:codesign": "codesign --force --sign - ./brigadier && codesign -v --strict ./brigadier",
    "build:dist": "bun build ./src/index.ts ./src/contracts.ts ./src/cli.ts --target=node --minify --sourcemap --outdir ./dist && tsc --project ./tsconfig.build.json",
    "build:mcp": "bun build ./src/mcp/server.ts --target=node --minify --sourcemap --outdir ./dist/mcp",
    "build:unsigned": "bun run build:dist && bun run build:binary",
    "check": "biome check .",
    "format": "biome format --write .",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "optionalDependencies": {
    "@stephen-golban/brigadier-darwin-arm64": "0.1.1",
    "@stephen-golban/brigadier-darwin-x64": "0.1.1",
    "@stephen-golban/brigadier-linux-arm64": "0.1.1",
    "@stephen-golban/brigadier-linux-x64": "0.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
